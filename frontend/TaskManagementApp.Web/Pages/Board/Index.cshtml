@page
@model TaskManagementApp.Web.Pages.Board.IndexModel
@{
    ViewData["Title"] = "Kanban Board";
}

<div class="board-container d-flex flex-column h-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold m-0">Project Board</h3>
        <div>
            <button class="btn btn-outline-secondary rounded-pill me-2"><i class="fa-solid fa-filter me-1"></i> Filter</button>
            <button class="btn btn-outline-secondary rounded-pill"><i class="fa-solid fa-ellipsis"></i></button>
        </div>
    </div>

    <!-- Kanban Columns -->
    <div class="kanban-board d-flex gap-4 flex-grow-1 overflow-x-auto pb-3">
        
        <!-- To Do Column -->
        <div class="kanban-column d-flex flex-column" style="min-width: 320px; width: 320px;">
            <div class="column-header d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold m-0 text-uppercase text-muted">To Do <span class="badge bg-secondary ms-2 rounded-pill">@Model.ToDoTasks.Count</span></h6>
                <button class="btn btn-sm btn-link text-muted"><i class="fa-solid fa-plus"></i></button>
            </div>
            <div class="column-body flex-grow-1 glass-panel p-2 rounded custom-scrollbar sortable-list" data-status="To Do">
                @foreach (var task in Model.ToDoTasks)
                {
                    <partial name="_TaskCard" model="task" />
                }
            </div>
        </div>

        <!-- In Progress Column -->
        <div class="kanban-column d-flex flex-column" style="min-width: 320px; width: 320px;">
            <div class="column-header d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold m-0 text-uppercase text-primary">In Progress <span class="badge bg-primary ms-2 rounded-pill">@Model.InProgressTasks.Count</span></h6>
                <button class="btn btn-sm btn-link text-muted"><i class="fa-solid fa-plus"></i></button>
            </div>
            <div class="column-body flex-grow-1 glass-panel p-2 rounded custom-scrollbar sortable-list" data-status="In Progress">
                @foreach (var task in Model.InProgressTasks)
                {
                    <partial name="_TaskCard" model="task" />
                }
            </div>
        </div>

        <!-- Review Column -->
        <div class="kanban-column d-flex flex-column" style="min-width: 320px; width: 320px;">
            <div class="column-header d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold m-0 text-uppercase text-warning">Review <span class="badge bg-warning ms-2 rounded-pill">@Model.ReviewTasks.Count</span></h6>
                <button class="btn btn-sm btn-link text-muted"><i class="fa-solid fa-plus"></i></button>
            </div>
            <div class="column-body flex-grow-1 glass-panel p-2 rounded custom-scrollbar sortable-list" data-status="Review">
                @foreach (var task in Model.ReviewTasks)
                {
                    <partial name="_TaskCard" model="task" />
                }
            </div>
        </div>

        <!-- Done Column -->
        <div class="kanban-column d-flex flex-column" style="min-width: 320px; width: 320px;">
            <div class="column-header d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold m-0 text-uppercase text-success">Done <span class="badge bg-success ms-2 rounded-pill">@Model.DoneTasks.Count</span></h6>
                <button class="btn btn-sm btn-link text-muted"><i class="fa-solid fa-plus"></i></button>
            </div>
            <div class="column-body flex-grow-1 glass-panel p-2 rounded custom-scrollbar sortable-list" data-status="Done">
                @foreach (var task in Model.DoneTasks)
                {
                    <partial name="_TaskCard" model="task" />
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <!-- SortableJS for Drag and Drop -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const columns = document.querySelectorAll('.sortable-list');
            columns.forEach(col => {
                new Sortable(col, {
                    group: 'shared',
                    animation: 150,
                    ghostClass: 'bg-secondary',
                    onEnd: function (evt) {
                        const itemEl = evt.item;
                        const newStatus = evt.to.getAttribute('data-status');
                        const taskId = itemEl.getAttribute('data-task-id');
                        
                        console.log(`Task ${taskId} moved to ${newStatus}`);
                    }
                });
            });
        });
    </script>
}
