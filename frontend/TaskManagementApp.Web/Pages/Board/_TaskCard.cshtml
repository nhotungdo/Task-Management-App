@model TaskManagementApp.Web.Models.TaskDto

@{
    var tagClass = Model.Priority.ToLower() switch
    {
        "high" => "bg-danger",
        "medium" => "bg-warning text-dark",
        "low" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    var isOverdue = Model.DueDate.HasValue && Model.DueDate.Value < DateTime.UtcNow && Model.Status != "Done";
}

<div class="task-card glass-panel p-3 mb-2 cursor-pointer" data-task-id="@Model.TaskId" data-bs-toggle="offcanvas" data-bs-target="#taskDetailDrawer">
    <div class="d-flex justify-content-between mb-2">
        <span class="badge @tagClass rounded-pill">@Model.Priority</span>
        <i class="fa-solid fa-ellipsis text-muted"></i>
    </div>
    
    <h6 class="fw-bold text-white mb-3">@Model.Title</h6>
    
    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="task-meta d-flex align-items-center">
            @if (Model.DueDate.HasValue)
            {
                <span class="text-muted" style="font-size: 0.8rem; @(isOverdue ? "color: #ff6b6b !important;" : "")">
                    <i class="fa-regular fa-clock me-1"></i> @Model.DueDate.Value.ToString("MMM dd")
                </span>
            }
        </div>
        <div class="avatar bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 10px;" title="Owner ID: @Model.OwnerId">
            U
        </div>
    </div>
</div>
